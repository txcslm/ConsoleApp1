            {
               "name": "中国军衔",
               "keys": [
                  "国军军衔"
               ],
               "secondary_keys": [
                  "中国军衔",
                  "中国军队军衔"
               ],
               "content": "国民革命军(国军)的军衔包括特级上将、一级上将、二级上将、中将、少将、上校、中校、少校、上尉、中尉、少尉、一级士官长、二级士官长、三级士官长、上士、中士、下士、上等兵、一等兵和二等兵。特别要注意的是，特级上将军衔专属于蒋介石。",
               "enabled": true,
               "insertion_order": 10,
               "case_sensitive": false,
               "priority": 10,
               "id": 19,
               "comment": "",
               "selective": false,
               "constant": false,
               "position": "",
               "extensions": {
