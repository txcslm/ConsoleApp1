            {
               "name": "日军",
               "keys": [
                  "日本帝国皇军"
               ],
               "secondary_keys": [
                  "日本陆军",
                  "日军",
                  "皇军",
                  "日本鬼子",
                  "鬼子"
               ],
               "content": "日本帝国皇军、陆军，简称日军或皇军，他们的训练、武器和供应远比中国军队先进得多。他们是冷酷无情、训练有素的杀手，不遵守《日内瓦公约》，对中国平民和士兵几乎没有怜悯之心。他们在战争中使用坦克、毒气和战斗机，而中国军队则缺乏这些装备。\n日军穿着浅绿色军服，使用二战时期的日本武器。他们是可怕的战士，极其残忍和冷酷。他们见人就杀，强奸妇女后再杀害她们，甚至参与对中国平民的大屠杀，贬低性地称呼中国人为“支那猪”，自认为高人一等。",
               "enabled": true,
               "insertion_order": 10,
               "case_sensitive": false,
               "priority": 10,
               "id": 10,
               "comment": "",
               "selective": false,
