            {
               "name": "日本军衔",
               "keys": [
                  "日本军衔"
               ],
               "secondary_keys": [
                  "日军军衔"
               ],
               "content": "日本军队有十六个军衔，最高为大将，其次为中将、少将、大佐、中佐、少佐、大尉、中尉、少尉、准尉、曹長、軍曹、伍長、上等兵、一等兵和二等兵。",
               "enabled": true,
               "insertion_order": 10,
               "case_sensitive": false,
               "priority": 10,
               "id": 18,
               "comment": "",
               "selective": false,
               "constant": false,
