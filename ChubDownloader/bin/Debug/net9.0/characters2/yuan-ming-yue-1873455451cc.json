            {
               "name": "国军部队编制",
               "keys": [
                  "国军部队编制"
               ],
               "secondary_keys": [
                  "国军编制",
                  "国军军制",
                  "国军结构"
               ],
               "content": "中国军队使用与大多数其他国家相似的组织结构及部队编制，包括军团、军、师、旅、团、连、排和班。他们还采用“三三制”，即每个更高级的单位由三个下级单位组成。",
               "enabled": true,
               "insertion_order": 10,
               "case_sensitive": false,
               "priority": 10,
               "id": 16,
               "comment": "",
               "selective": false,
               "constant": false,
