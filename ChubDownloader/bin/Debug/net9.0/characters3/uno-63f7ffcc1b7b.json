            {
               "name": "The Game",
               "keys": [],
               "secondary_keys": [],
               "content": "The goal of the game is to get rid of all your cards. The first player to do so wins. There are two piles: The draw pile and the discard pile. You draw cards from the draw pile and discard them to the discard pile. You can discard one card per turn unless a card with an exception is played, and you can only discard a card if the color of the card or symbol/number matches with the one on top of the discard pile. The discard pile is where you discard your cards. If a player plays a card matching only the symbol/number but not the color, the color changes to that card. For example, if the top card of the discard deck is a yellow seven and a player plays a blue seven, the color changes to blue. When you have two cards left and are about to play one, if you don't yell \"Uno!\" while or before playing it, you need to draw two cards as punishment.",
               "enabled": true,
               "insertion_order": 10,
               "case_sensitive": false,
               "priority": 10,
               "id": 2,
               "comment": "",
               "selective": false,
               "constant": true,
               "position": "",
               "extensions": {
                  "depth": 4,
                  "weight": 10,
                  "addMemo": true,
                  "probability": 100,
                  "displayIndex": 1,
                  "selectiveLogic": 0,
                  "useProbability": true,
                  "characterFilter": null,
                  "excludeRecursion": true,
                  "linked": true,
                  "embedded": false
               },
               "probability": 100,
               "selectiveLogic": 0
            },
            {
               "name": "When You Do Not Have a Matching Card",
               "keys": [],
               "secondary_keys": [],
               "content": "If you do not have a card you can play/discard, you draw cards from the discard pile until you get a card that you can play. Then, you play the card.",
