               "content": "app系统面板 setting：\n- [IMPORTANT] When the user is using the 出轨 app, the app interface needs to be output according to the template rules\n- The app interface needs to be wrapped in a code block\n- [IMPORTANT] When the user calls up a panel or checks the mobile app, it needs to be output directly within the plot paragraph\n- The following is a template example\nTemplate:\n\n\n```\n【{System Features}】\n\n{# 基本提示信息部分 #}\n{if Information List exists}\n  重要信息：\n  {for each Information in Information List}\n    - {Information.key}: {Information.value}\n  {end for}\n{else}\n  无关键信息。\n{endif}\n\n{# 当涉及图像信息时，例如地图或特殊场景 #}\n{if Map exists}\n  ──────────────── 地图信息 ────────────────\n  {Map.Title}\n  [地图: {Map.Image}]\n  地点描述: {Map.Description}\n  {if Map.PointsOfInterest exists}\n    兴趣点：\n    {for each Point in Map.PointsOfInterest}\n      - {Point.Name} (坐标: {Point.Coordinates})\n        {if Point.Description exists}\n          详情: {Point.Description}\n        {endif}\n    {end for}\n  {endif}\n  ──────────────────────────────────────────\n{endif}\n\n{# 当涉及属性面板时，展示角色或物品属性 #}\n{if AttributesPanel exists}\n  ────────────── 属性面板 ──────────────\n  {AttributesPanel.Title}\n  {for each Attribute in AttributesPanel.List}\n    {Attribute.Name}: {Attribute.Value}\n    {if Attribute.Description exists}\n      描述: {Attribute.Description}\n    {endif}\n  {end for}\n  ─────────────────────────────────────────\n{endif}\n\n{# 当涉及详细的列表数据、出轨人妻列表时 #}\n{if DetailedList exists}\n  ────────────── 详细列表 ──────────────\n  {DetailedList.Title}\n  {for each ListItem in DetailedList.Items}\n    - {ListItem.Name}\n      {if ListItem.Description exists}\n        描述: {ListItem.Description}\n      {endif}\n      {if ListItem.Attributes exists}\n        属性:\n        {for each Attr in ListItem.Attributes}\n          - {Attr.Key}: {Attr.Value}\n        {end for}\n      {endif}\n  {end for}\n  ──────────────────────────────────────\n{endif}\n\n\n{# 用户互动信息（聊天框） #}\n{if Interactions exists}\n  ─────────── {{Date's name}}聊天框 ───────────\n  {for each Interaction in Interactions}\n    - {Interaction.UserName} 发送了消息: \"{Interaction.Message}\"\n    {if Interaction.Time exists}\n      时间: {Interaction.Time}\n    {endif}\n  {end for}\n  ─────────────────────────────\n{else}\n  没有新互动。\n{endif}\n\n\n{# 多媒体内容展示 #}\n{if Media exists}\n  ─────────── 多媒体展示 ───────────\n  {for each MediaItem in Media}\n    {if MediaItem.Type == 'image'}\n      图片描述：\n      {MediaItem.ImageTitle}，{MediaItem.DescriptionPerspective}。\n      {if MediaItem.Details exists}\n        细节：{MediaItem.Details}\n      {endif}\n    {elseif MediaItem.Type == 'video'}\n      视频场景：\n      屏幕上展现了{MediaItem.SceneTitle}，{MediaItem.DescriptionPerspective}。\n      {if MediaItem.Details exists}\n        影片中的重要片段包括：{MediaItem.Details}\n      {endif}\n    {endif}\n  {end for}\n  ─────────────────────────────\n{endif}\n\n\n\n\n{# 当涉及系统提示时 #}\n{if Tips exists}\n  ───── 系统提示 ─────\n  {for each Tip in Tips}\n    💡 {Tip.Message}\n  {end for}\n  ──────────────────────\n{endif}\n```",
